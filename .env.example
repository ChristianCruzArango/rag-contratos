# ==========================================================
#  BASE DE DATOS (docker compose la levanta con estos valores)
# ==========================================================
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb
POSTGRES_PORT=5434
POSTGRES_HOST=localhost

# El backend usa esta URL. Dentro de Docker cambia localhost -> postgres
DATABASE_URL=postgresql://rag:ragpass@localhost:5434/ragdb

# pgAdmin (opcional: docker compose --profile tools up -d)
PGADMIN_EMAIL=admin@rag.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ==========================================================
#  OPENROUTER  ->  generación de respuestas (chat)
#  https://openrouter.ai/keys
# ==========================================================
OPENROUTER_API_KEY=sk-or-v1-CAMBIA_ESTO
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Cabeceras opcionales de atribución que OpenRouter usa en su ranking
OPENROUTER_SITE_URL=http://localhost:4200
OPENROUTER_SITE_NAME=RAG Contratos

# ==========================================================
#  EMBEDDINGS
#  OJO: OpenRouter NO tiene endpoint /embeddings. Hay que usar
#  otro proveedor compatible con la API de OpenAI.
#
#  Opción A (por defecto) - OpenAI:
#     EMBEDDING_BASE_URL=https://api.openai.com/v1
#     EMBEDDING_MODEL=text-embedding-3-small   -> 1536 dims
#
#  Opción B - Ollama local (gratis, sin API key):
#     ollama pull nomic-embed-text
#     EMBEDDING_BASE_URL=http://localhost:11434/v1
#     EMBEDDING_API_KEY=ollama
#     EMBEDDING_MODEL=nomic-embed-text         -> 768 dims
#
#  Si cambias de modelo, cambia EMBEDDING_DIMENSIONS y ejecuta:
#     npm run db:resize-vector   (en backend/)
# ==========================================================
EMBEDDING_PROVIDER=local
EMBEDDING_LOCAL_MODEL=Xenova/multilingual-e5-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32

# ==========================================================
#  OCR — para PDFs escaneados (sin capa de texto) e imágenes
#
#  Un PDF escaneado es una foto: no contiene texto, así que sin
#  OCR se indexaría vacío. El OCR lo reconoce y lo convierte en
#  texto buscable.
#
#  OCR_MODE:
#    auto  = solo las páginas cuyo texto extraído no llega a
#            OCR_MIN_CHARS (un PDF nativo no paga OCR)
#    force = todas las páginas, ignorando la capa de texto
#            (útil si el PDF trae un OCR previo de mala calidad)
#    never = desactivado
#
#  OCR_ENGINE:
#    tesseract = local, gratis, sin enviar nada fuera. ~2,5 s/página
#    vision    = modelo multimodal vía OpenRouter: lee mejor tablas
#                y escaneos malos, pero cuesta por página y puede
#                "normalizar" lo que no se lee bien
# ==========================================================
OCR_ENABLED=true
OCR_MODE=auto
OCR_ENGINE=tesseract
OCR_LANGS=spa
OCR_MIN_CHARS=120
OCR_SCALE=2
OCR_CONCURRENCY=2
OCR_MIN_CONFIDENCE=60
OCR_MAX_PAGES=50
OCR_CACHE_PATH=./.cache/tessdata
OCR_VISION_MODEL=google/gemini-2.5-flash-lite

# ==========================================================
#  RAG
# ==========================================================
CHUNK_SIZE=1200          # caracteres por fragmento
CHUNK_OVERLAP=200        # solape entre fragmentos
RAG_TOP_K=8              # fragmentos recuperados por consulta
RAG_MIN_SCORE=0.0

# ==========================================================
#  APP
# ==========================================================
PORT=3000
CORS_ORIGIN=http://localhost:4200
